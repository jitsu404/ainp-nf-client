# Client environment settings. Copy to .env.local (git-ignored) and change as needed.

# Base URL of the API.
# Leave unset to use '/api/v1', which Vite proxies to the backend in development (see vite.config.js).
# On Vercel leave it unset too: vercel.json forwards /api/* to the deployed backend, so the API is
# same-origin and the SameSite=Strict session cookie works.
# If you set a full URL, the backend's CLIENT_ORIGIN must be this app's origin
# (e.g. http://localhost:5174), and both must be on the same site because of the SameSite=Strict cookie.
# VITE_API_BASE_URL=http://localhost:5000/api/v1

# Backend the dev proxy forwards /api to (default http://localhost:5000). Not a VITE_ variable:
# it's read by vite.config.js, not by the app.
# API_URL=http://localhost:5000
